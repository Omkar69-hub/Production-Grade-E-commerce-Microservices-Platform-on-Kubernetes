# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_password
DB_NAME=ecommerce_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT Security
JWT_SECRET=vErYsEcReTkEyThAtIsAtLeAsT32ByTeSlOnGfOrHs256
JWT_EXPIRATION_MS=86400000

# React Frontend (Development defaults to http://localhost:8080; production requires valid HTTPS URL or /api)
VITE_API_GATEWAY_URL=/api

# API Gateway CORS Configuration (Production requires explicit allowed origins; dev defaults to localhost)
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# Initial Administrator Bootstrap (Optional - created only when both are set)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Internal Checkout & Mock Payments Feature Flag (Disabled by default: 'false')
ENABLE_INTERNAL_CHECKOUT=false
VITE_ENABLE_INTERNAL_CHECKOUT=false

# Refresh Cookie Security (Fix 4: HTTP-only session cookie configuration)
# In production, COOKIE_SECURE should be true (HTTPS only)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth
