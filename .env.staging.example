# ==============================================================================
# LUMIÈRE — Staging Environment Template (.env.staging.example)
# Architecture: Cloudflare Pages (Frontend) + OCI Ampere A1 ARM64 (Backend)
#
# IMPORTANT:
# - Copy this file to .env.staging (which is strictly ignored by Git).
# - Replace all <PLACEHOLDERS> with newly generated, cryptographically strong values.
# - NEVER commit real credentials, passwords, tokens, or JWT secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# Staging database credentials — must be unique and never use default "postgres"
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=lumiere_staging_user
DB_PASSWORD=<GENERATE_STRONG_STAGING_DB_PASSWORD>
DB_NAME=ecommerce_db

# ------------------------------------------------------------------------------
# 2. DISTRIBUTED CACHE & SESSION STORE (Redis 7)
# Requirepass must be enabled in staging
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<GENERATE_STRONG_REDIS_AUTH_TOKEN>

# ------------------------------------------------------------------------------
# 3. ASYNCHRONOUS EVENT BROKER (RabbitMQ 3)
# Dedicated staging application user — do not use default "guest"
# ------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=lumiere_staging_rabbit
RABBITMQ_PASSWORD=<GENERATE_STRONG_RABBITMQ_PASSWORD>

# ------------------------------------------------------------------------------
# 4. JWT & AUTHENTICATION SECURITY
# Mandatory: 256-bit+ cryptographically random signing key (no code fallback)
# ------------------------------------------------------------------------------
JWT_SECRET=<GENERATE_CRYPTOGRAPHICALLY_SECURE_256_BIT_SECRET_MIN_32_BYTES>
JWT_EXPIRATION_MS=900000 # 15 minutes (access token)
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days (refresh token)

# ------------------------------------------------------------------------------
# 5. COOKIE & CSRF DEFENSE (HTTPS Staging Environment)
# COOKIE_SECURE MUST be true in staging (over HTTPS)
# COOKIE_SAME_SITE: "None" if frontend (*.pages.dev) and backend are cross-site;
#                   "Lax" or "Strict" if sharing an apex domain (e.g. *.yourdomain.com)
# ------------------------------------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAME_SITE=None
COOKIE_DOMAIN=
COOKIE_PATH=/api/v1/auth

# ------------------------------------------------------------------------------
# 6. CORS & ORIGIN CONTROL (API Gateway & Auth CSRF Filter)
# Specify exact Cloudflare Pages frontend URL(s) and any custom staging domains
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://lumiere-staging.pages.dev,https://staging.yourdomain.com
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.pages.dev

# ------------------------------------------------------------------------------
# 7. SPRING RUNTIME PROFILE
# Must be "prod" to enforce fail-closed CORS and disable development defaults
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# 8. OCI VM HOST BINDINGS (Security Hardening)
# Bind Gateway to loopback (127.0.0.1) if fronted by Cloudflare Tunnel / reverse proxy
# Set to 0.0.0.0 only if directly exposing port behind an OCI network security group
# ------------------------------------------------------------------------------
GATEWAY_BIND_IP=127.0.0.1
GATEWAY_PORT=8080
MAILPIT_UI_PORT=8025

# ------------------------------------------------------------------------------
# 9. BOOTSTRAP ADMINISTRATOR (Optional - Initial Staging Admin Account)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@staging.lumiere.internal
ADMIN_PASSWORD=<GENERATE_STRONG_ADMIN_BOOTSTRAP_PASSWORD>

# ------------------------------------------------------------------------------
# 10. EDITORIAL REFERRAL PLATFORM GUARD (Strictly Disabled)
# Internal checkout and mock payments MUST remain disabled (false)
# ------------------------------------------------------------------------------
ENABLE_INTERNAL_CHECKOUT=false

# ------------------------------------------------------------------------------
# 11. CLOUDFLARE PAGES FRONTEND BUILD VARIABLES (Set in Cloudflare Dashboard)
# Reference values for Cloudflare Pages Project Settings -> Environment Variables
# ------------------------------------------------------------------------------
# VITE_API_GATEWAY_URL=https://api-staging.yourdomain.com
# VITE_ENABLE_INTERNAL_CHECKOUT=false

# ------------------------------------------------------------------------------
# 12. JVM MEMORY TUNING (OCI Ampere A1 ARM64 Optimizations)
# Default sizing per microservice: 128 MB min, 256 MB max heap using ZGC
# ------------------------------------------------------------------------------
JAVA_OPTS=-XX:+UseZGC -Xms128m -Xmx256m
